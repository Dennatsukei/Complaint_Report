# ============================================================
# 运行配置模板：复制为 .env 后填入自己的 LLM_API_KEY 即可
# .env 已被 .gitignore 忽略，请勿把真实密钥提交到版本库
# ============================================================

# LLM API Key（必填，请自行填入）
LLM_API_KEY=your_api_key

# LLM Base URL / 模型名（如无特殊需求保持默认）
# DeepSeek 当前模型：deepseek-v4-flash | deepseek-v4-pro | deepseek-v4-flash-vision-exp(实验)
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# 出站脱敏模式：off | pii | strict
MASKING_MODE=pii

# 输入目录与运行标识（可在启动菜单中选择 2 覆盖并保存）
INPUT_DIR=inputs/samples
RUN_ID=sample
